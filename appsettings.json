{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "Hosting": {
                "Url": "http://*:80"
            }
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:4000",
            "https://app.yourmealtracker.com"
        ]
    },
    "Jwt": {
        "Issuer": "https://diet-tracker.yourdomain.com",
        "Audience": "https://diet-tracker.yourdomain.com",
        "AccessTokenExpiryMinutes": 15,
        "RefreshTokenExpiryDays": 7
    }
}